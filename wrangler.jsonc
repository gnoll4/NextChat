{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextchat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "vars": {
    "DEEPSEEK_URL": "https://api.deepseek.com",
    "HIDE_USER_API_KEY": "1"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
